# Backend Environment Configuration

# Server Port
PORT=5000

# Environment (development | production)
NODE_ENV=production

# Database Connection (MongoDB Atlas Connection String)
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/nutrifit?retryWrites=true&w=majority
MONGODB_URI=

# JWT Secret Key for user authentication
JWT_SECRET=your_jwt_secret_key_here

# Allowed Frontend Client Origin (for CORS security)
# Example: https://your-app-name.onrender.com or https://your-app.vercel.app
CLIENT_ORIGIN=*
